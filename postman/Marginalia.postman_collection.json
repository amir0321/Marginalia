				{
					"name": "Logga in (Login)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    const data = pm.response.json();",
									"    if (data.token) {",
									"        pm.collectionVariables.set(\"token\", data.token);",
									"        console.log(\"Token sparades automatiskt i variabeln 'token'!\");",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"username\": \"bokalvan\",\n  \"password\": \"Losenord123!\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/auth/login",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"auth",
								"login"
							]
						},
						"description": "Loggar in och sparar automatiskt JWT Bearer-token i Postman-variabeln {{token}}."
					},
					"response": []
				}
			]
		},
